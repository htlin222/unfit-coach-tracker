{
  "name": "unfit-coach-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "Public-sector unfit coach registry tracker — Primer.style UI, Cloudflare D1, cron-synced.",
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "deploy:pages": "pnpm build && wrangler pages deploy",
    "deploy:worker": "wrangler deploy -c wrangler.worker.toml",
    "worker:tail": "wrangler tail -c wrangler.worker.toml",
    "db:create": "wrangler d1 create unfit-coach-db",
    "db:migrate": "wrangler d1 execute unfit-coach-db --file=schema.sql --remote",
    "db:seed": "wrangler d1 execute unfit-coach-db --file=seed.sql --remote",
    "db:local": "wrangler d1 execute unfit-coach-db --local --file=schema.sql",
    "db:local:seed": "wrangler d1 execute unfit-coach-db --local --file=seed.sql",
    "dev:full": "pnpm build && wrangler pages dev dist --d1=DB"
  },
  "dependencies": {
    "@primer/octicons-react": "^19.32.0",
    "@primer/react": "^36.27.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "styled-components": "^5.3.11"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "wrangler": "^4.0.0"
  }
}
